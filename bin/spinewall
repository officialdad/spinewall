#!/usr/bin/env bash
# Thin shim kept for the legacy installer until the installer phase ships the Go
# binary as `spinewall`. It holds no logic of its own: the CLI moved to the Go
# binary in phase 3, so it just runs one when it can find it.
set -euo pipefail
self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
candidates=()
if [ -n "${SPINEWALL_CLI:-}" ]; then candidates+=("$SPINEWALL_CLI"); fi
candidates+=("$self/../spinewall" "$self/spinewall-go")
for candidate in "${candidates[@]}"; do
  if [ -x "$candidate" ]; then exec "$candidate" "$@"; fi
done
echo "error: the spinewall CLI is the Go binary now. Build it with: go build -o spinewall ./cmd/spinewall" >&2
exit 1
